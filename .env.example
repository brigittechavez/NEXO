# =============================================================================
# NEXO — Environment Variables
# =============================================================================
# NEXO runs WITHOUT any of this: with no credentials configured the app falls
# back to a local demo adapter (see src/app/core/services/auth.service.ts) and
# every screen, including the demo mentee/mentor accounts, stays usable.
#
# Fill these in to switch authentication over to a real Supabase project.
# NEVER commit a real .env to version control.

# -----------------------------------------------------------------------------
# Supabase (public client credentials)
# -----------------------------------------------------------------------------
# Both values are in your Supabase dashboard under Project Settings → API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# -----------------------------------------------------------------------------
# How these reach the Angular app
# -----------------------------------------------------------------------------
# Angular does not read .env files at runtime. Copy the two values above into:
#
#   src/environments/environment.ts              (production build)
#   src/environments/environment.development.ts  (ng serve)
#
# Both files ship with the placeholders YOUR_SUPABASE_URL / YOUR_SUPABASE_PUBLISHABLE_KEY.
# While those placeholders are in place, `isSupabaseConfigured()` returns false
# and the app uses the demo adapter — no network calls, no errors.
#
# On Netlify, set SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY as build environment
# variables and generate src/environments/environment.ts from them in the build
# command, so the keys never live in the repository.

# -----------------------------------------------------------------------------
# SSR host allowlist  (Node SSR server and, if it 400s, the Netlify deploy)
# -----------------------------------------------------------------------------
# Angular 22 rejects requests whose Host header is not allowlisted (SSRF
# protection). angular.json allows localhost/127.0.0.1 for local runs; set this
# to your real domain when serving `npm run serve:ssr:nexo` in production.
# Comma-separated. Leaving it unset while serving from a real domain makes every
# route answer HTTP 400.
NG_ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# SECURITY NOTES
# =============================================================================
# - Only the publishable key belongs in frontend code.
# - NEVER expose the service role key, any secret key, or the database password.
# - The publishable key is safe in the browser ONLY if Row Level Security is enabled and
#   policies are configured on every table before going to production.
